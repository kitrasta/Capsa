# Скопируй в .env и подставь значения своего сервера.
# .env не коммитится — в нём адреса твоей инфраструктуры.

# Адрес client-server API homeserver'а (Synapse/Dendrite/Conduit).
# Именно сюда ходит matrix-js-sdk: /_matrix/client/v3/...
VITE_MATRIX_HOMESERVER_URL=https://matrix.example.com

# server_name — домен из Matrix ID (@user:example.com). Нужен для via
# (spaces) и федерации. Если не задан, берётся хост из
# VITE_MATRIX_HOMESERVER_URL (подходит без делегирования).
VITE_MATRIX_SERVER_NAME=example.com
